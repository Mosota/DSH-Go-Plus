+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:url_launcher/url_launcher.dart';
+
+import '../../l10n/l10n.dart';
+import '../../state/phone_state.dart';
+import '../common/brief_notice.dart';
+import '../common/list_page_row.dart';
+import '../common/segmented_pill.dart';
+import '../shell/page_frame.dart';
+import '../theme/app_icons.dart';
+import 'dnd_mode_page.dart' show shizukuDownloadUrl;
+import 'background_advanced.dart';
+import 'phone_widgets.dart';
+import 'restricted_settings_guide.dart' show RomFamily;
+
+/// Group spacing: 24 between consecutive cards.
+const _groupMargin = EdgeInsets.fromLTRB(16, 12, 16, 12);
+
+/// 特权通道: the shell-uid channel behind both 虚拟屏 and the model's
+/// `shell`/`device` tools — Shizuku (or a compatible manager) or the app's own
+/// wireless-debugging connection. Off by default; the page says plainly what it
+/// costs and what it doesn't do.
+class PhonePrivilegedPage extends ConsumerStatefulWidget {
+  const PhonePrivilegedPage({super.key});
+
+  @override
+  ConsumerState<PhonePrivilegedPage> createState() => _PhonePrivilegedPageState();
+}
+
+class _PhonePrivilegedPageState extends ConsumerState<PhonePrivilegedPage> {
+  /// Which setup is shown; starts at the mode in use (Shizuku when off).
+  PhoneBackgroundMode? _view;
+  bool _busy = false;
+  String? _error;
+  late final AppLifecycleListener _lifecycle;
+
+  PhoneController get _phone => ref.read(phoneProvider.notifier);
+
+  @override
+  void initState() {
+    super.initState();
+    _lifecycle = AppLifecycleListener(onResume: () => unawaited(_phone.refreshStatus()));
+  }
+
+  @override
+  void dispose() {
+    _lifecycle.dispose();
+    super.dispose();
+  }
+
+  void _toast(String text) {
+    if (!mounted) return;
+    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));
+  }
+
+  Future<void> _run(Future<PhoneResult> Function() action, {String? done}) async {
+    if (_busy) return;
+    setState(() {
+      _busy = true;
+      _error = null;
+    });
+    final result = await action();
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      _error = result.ok ? null : (result.reason ?? context.l10n.phoneActionFailedLater);
+    });
+    if (result.ok && done != null) showBriefNotice(context, done);
+  }
+
+  Future<void> _setMode(PhoneBackgroundMode mode) => _run(
+    () => _phone.setBackgroundMode(mode),
+    done: mode == PhoneBackgroundMode.off ? '特权通道已关闭' : '特权通道已开启',
+  );
+
+  Future<void> _grantShizuku() async {
+    if (_busy) return;
+    setState(() => _busy = true);
+    final ok = await _phone.requestShizukuPermission();
+    if (!mounted) return;
+    setState(() => _busy = false);
+    if (!ok) _toast(context.l10n.phoneDndShizukuPermissionFailed);
+  }
+
+  Future<void> _openShizukuSite() async {
+    var ok = false;
+    try {
+      ok = await launchUrl(Uri.parse(shizukuDownloadUrl), mode: LaunchMode.externalApplication);
+    } catch (_) {}
+    if (!ok && mounted) {
+      _toast(context.l10n.phoneDndBrowserFailed(shizukuDownloadUrl));
+    }
+  }
+
+  Future<void> _manualPair() async {
+    final l10n = context.l10n;
+    final entered = await showDialog<(String, int?)>(context: context, builder: (_) => const _PairDialog());
+    if (entered == null) return;
+    await _run(() => _phone.adbPair(entered.$1, port: entered.$2), done: l10n.phoneDndPairedConnect);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final bg = ref.watch(phoneProvider.select((s) => s.status.background));
+    final view = _view ?? (bg.mode == PhoneBackgroundMode.off ? PhoneBackgroundMode.shizuku : bg.mode);
+    final usable = bg.androidOk;
+
+    return AppPage.list(
+      title: '特权通道',
+      subtitle: const Text('给虚拟屏和模型的 shell 工具提供 shell 身份'),
+      children: [
+        if (!usable) PhoneNote(tone: NoteTone.warn, text: l10n.phoneDndUnsupported),
+        ListPageCard(
+          margin: _groupMargin,
+          title: '使用前提',
+          children: [
+            BulletLines([l10n.phoneDndKeepUnlocked, l10n.phoneDndReactivate, l10n.phoneDndKeepDebugging]),
+          ],
+        ),
+        if (bg.mode != PhoneBackgroundMode.off)
+          ListPageCard(
+            margin: _groupMargin,
+            children: [
+              ListPageRow(
+                icon: AppIcons.dndMode,
+                iconColor: Theme.of(context).colorScheme.primary,
+                title: bg.mode == PhoneBackgroundMode.shizuku ? l10n.phoneDndUsing('Shizuku') : l10n.phoneDndUsing('自连 ADB'),
+                subtitle: _usingSubtitle(bg, l10n),
+                trailing: TextButton(
+                  onPressed: _busy ? null : () => _setMode(PhoneBackgroundMode.off),
+                  child: Text(l10n.commonClose),
+                ),
+              ),
+            ],
+          ),
+        if (bg.mode != PhoneBackgroundMode.off && !bg.ready)
+          ListPageCard(
+            margin: _groupMargin,
+            children: [
+              ListPageRow(
+                icon: AppIcons.refresh,
+                title: '重新检查此通道',
+                subtitle: '重新绑定一次，通常 1–15 秒出结果；卡住会显示失败阶段',
+                subtitleMaxLines: 2,
+                onTap: _busy
+                    ? null
+                    : () => unawaited(_run(() => _phone.setBackgroundMode(bg.mode), done: '通道已重新检查')),
+              ),
+            ],
+          ),
+        Padding(
+          padding: const EdgeInsets.fromLTRB(16, 12, 16, 12),
+          child: SegmentedPill<PhoneBackgroundMode>(
+            segments: [
+              PillSegment(PhoneBackgroundMode.shizuku, 'Shizuku'),
+              PillSegment(PhoneBackgroundMode.adb, l10n.phoneDndDirectAdb),
+            ],
+            selected: view,
+            onChanged: (mode) => setState(() {
+              _view = mode;
+              _error = null;
+            }),
+          ),
+        ),
+        if (_error case final error?) PhoneNote(tone: NoteTone.warn, text: error),
+        if (view == PhoneBackgroundMode.shizuku) ..._shizuku(bg, usable) else ..._adb(bg, usable),
+        const PhoneAdvancedSettings(),
+      ],
+    );
+  }
+
+  /// 使用中卡片下面那行：优先显示连接失败的具体阶段，其次显示等待秒数，最后才是笼统原因。
+  String _usingSubtitle(PhoneBackgroundStatus bg, L10n l10n) {
+    if (bg.ready) return l10n.phoneReady;
+    final code = bg.shizuku.connectReason;
+    if (code != null && code.isNotEmpty) return '连接失败：$code（点「重新检查此通道」重试）';
+    if (bg.selectionPendingMs > 0) {
+      final seconds = (bg.selectionPendingMs / 1000).round();
+      return '正在连接通道（已 $seconds 秒）…点「重新检查此通道」可重试';
+    }
+    return bg.reason ?? l10n.phoneNotReadyYet;
+  }
+
+  List<Widget> _shizuku(PhoneBackgroundStatus bg, bool usable) {
+    final s = bg.shizuku;
+    final sdk = ref.watch(phoneProvider.select((p) => p.status.device.sdkInt));
+    final android17 = (sdk ?? 0) >= 37;
+    final allSet = s.installed && s.running && s.granted;
+    final inUse = bg.mode == PhoneBackgroundMode.shizuku;
+    final Widget next;
+    if (!s.installed) {
+      next = _Next(
+        text: context.l10n.phoneDndInstallShizuku,
+        button: OutlinedButton.icon(
+          onPressed: _openShizukuSite,
+          icon: const Icon(AppIcons.openExternal, size: 18),
+          label: Text(context.l10n.phoneDndOpenShizukuSite),
+        ),
+      );
+    } else if (!s.running) {
+      next = _Next(text: context.l10n.phoneDndStartShizuku);
+    } else if (!s.granted) {
+      next = _Next(
+        text: context.l10n.phoneDndGrantShizukuHint,
+        button: FilledButton(onPressed: _busy ? null : _grantShizuku, child: Text(context.l10n.phoneDndGrantShizuku)),
+      );
+    } else {
+      next = _Next(text: context.l10n.phoneDndShizukuAllSet);
+    }
+    return [
+      ListPageCard(
+        margin: _groupMargin,
+        title: 'Shizuku',
+        children: [
+          CheckRow(label: context.l10n.phoneDndShizukuInstalled, done: s.installed),
+          CheckRow(label: context.l10n.phoneDndShizukuRunning, done: s.running),
+          CheckRow(label: context.l10n.phoneDndShizukuGranted, done: s.granted),
+          next,
+        ],
+      ),
+      if (!inUse)
+        _EnableButton(onPressed: usable && allSet && !_busy ? () => _setMode(PhoneBackgroundMode.shizuku) : null),
+      if (android17) PageFootnote(context.l10n.phoneDndShizukuCompatibility),
+    ];
+  }
+
+  List<Widget> _adb(PhoneBackgroundStatus bg, bool usable) {
+    final a = bg.adb;
+    final maker = ref.watch(phoneProvider.select((s) => s.status.device.manufacturer));
+    final xiaomi = RomFamily.of(maker) == RomFamily.xiaomi;
+    final inUse = bg.mode == PhoneBackgroundMode.adb;
+    return [
+      ListPageCard(
+        margin: _groupMargin,
+        title: context.l10n.commonStatus,
+        children: [
+          CheckRow(
+            label: context.l10n.phoneDndWirelessDebuggingOn,
+            done: a.wirelessDebugging == true,
+            unknown: a.wirelessDebugging == null,
+          ),
+          CheckRow(label: context.l10n.phoneDndPaired, done: a.paired),
+          CheckRow(label: context.l10n.phoneDndConnected, done: a.connected),
+        ],
+      ),
+      ListPageCard(
+        margin: _groupMargin,
+        title: '配对一次',
+        children: [
+          NumberedSteps([
+            context.l10n.phoneDndDeveloperOptionsStep,
+            context.l10n.phoneDndWirelessDebuggingStep,
+            context.l10n.phoneDndStartPairingStep,
+            context.l10n.phoneDndGetPairingCodeStep,
+            context.l10n.phoneDndEnterPairingCodeStep,
+          ]),
+          Padding(
+            padding: const EdgeInsets.fromLTRB(16, 6, 16, 12),
+            // Three equal steps, equal width; the one filled button on the
+            // page stays 「启用虚拟屏」 below.
+            child: Row(
+              spacing: 8,
+              children: [
+                for (final (label, onPressed) in [
+                  (
+                    context.l10n.phoneDndStartPairing,
+                    usable && !_busy
+                        ? () => _run(_phone.adbStartPairing, done: context.l10n.phoneDndPairingNotificationSent)
+                        : null,
+                  ),
+                  (context.l10n.phoneDndManualEntry, usable && !_busy ? _manualPair : null),
+                  (
+                    context.l10n.phoneDndConnect,
+                    usable && a.paired && !_busy
+                        ? () => _run(_phone.adbConnect, done: context.l10n.phoneDndConnected)
+                        : null,
+                  ),
+                ])
+                  Expanded(
+                    child: OutlinedButton(
+                      style: OutlinedButton.styleFrom(padding: const EdgeInsets.symmetric(horizontal: 8)),
+                      onPressed: onPressed,
+                      child: FittedBox(fit: BoxFit.scaleDown, child: Text(label, maxLines: 1)),
+                    ),
+                  ),
+              ],
+            ),
+          ),
+        ],
+      ),
+      if (!inUse)
+        _EnableButton(onPressed: usable && a.connected && !_busy ? () => _setMode(PhoneBackgroundMode.adb) : null),
+      PageFootnote([context.l10n.phoneDndManualEntryHint, if (xiaomi) context.l10n.phoneDndXiaomiUsbHint].join('\n')),
+    ];
+  }
+}
+
+class _Next extends StatelessWidget {
+  const _Next({required this.text, this.button});
+
+  final String text;
+  final Widget? button;
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(16, 8, 16, 12),
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text(
+            text,
+            style: theme.textTheme.bodyMedium?.copyWith(color: theme.colorScheme.onSurfaceVariant, height: 1.5),
+          ),
+          if (button case final button?) ...[const SizedBox(height: 10), button],
+        ],
+      ),
+    );
+  }
+}
+
+class _EnableButton extends StatelessWidget {
+  const _EnableButton({required this.onPressed, this.label = '开启特权通道'});
+
+  final VoidCallback? onPressed;
+  final String label;
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(16, 4, 16, 0),
+      child: FilledButton(
+        style: FilledButton.styleFrom(minimumSize: const Size.fromHeight(48)),
+        onPressed: onPressed,
+        child: Text(label),
+      ),
+    );
+  }
+}
+
+/// The in-app pairing fallback: six-digit code, optional port.
+class _PairDialog extends StatefulWidget {
+  const _PairDialog();
+
+  @override
+  State<_PairDialog> createState() => _PairDialogState();
+}
+
+class _PairDialogState extends State<_PairDialog> {
+  final _code = TextEditingController();
+  final _port = TextEditingController();
+
+  @override
+  void dispose() {
+    _code.dispose();
+    _port.dispose();
+    super.dispose();
+  }
+
+  bool get _valid => RegExp(r'^\d{6}$').hasMatch(_code.text.trim());
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    return AlertDialog(
+      title: Text(l10n.phoneDndEnterCodeTitle),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          TextField(
+            controller: _code,
+            autofocus: true,
+            keyboardType: TextInputType.number,
+            maxLength: 6,
+            inputFormatters: [FilteringTextInputFormatter.digitsOnly],
+            decoration: InputDecoration(labelText: l10n.phoneDndCodeLabel),
+            onChanged: (_) => setState(() {}),
+          ),
+          TextField(
+            controller: _port,
+            keyboardType: TextInputType.number,
+            maxLength: 5,
+            inputFormatters: [FilteringTextInputFormatter.digitsOnly],
+            decoration: InputDecoration(labelText: l10n.phoneDndPortLabel, helperText: l10n.phoneDndPortHint),
+          ),
+        ],
+      ),
+      actions: [
+        TextButton(onPressed: () => Navigator.pop(context), child: Text(l10n.commonCancel)),
+        FilledButton(
+          onPressed: _valid ? () => Navigator.pop(context, (_code.text.trim(), int.tryParse(_port.text.trim()))) : null,
+          child: Text(l10n.phoneDndPair),
+        ),
+      ],
+    );
+  }
+}
diff --git a/app/lib/ui/phone/shell_tool_page.dart b/app/lib/ui/phone/shell_tool_page.dart
new file mode 100644
index 00000000..87f22764
--- /dev/null
+++ b/app/lib/ui/phone/shell_tool_page.dart
@@ -0,0 +1,180 @@
+// 模型 shell 工具: what the model may run on this phone, what it may not, and the
+// one switch that allows it. The tool rides 特权通道 (shell uid) but has its own
+// consent, so opening the channel never silently hands the model a shell.
+
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../state/phone_state.dart';
+import '../common/list_page_row.dart';
+import '../shell/page_frame.dart';
+import '../theme/app_icons.dart';
+import 'phone_widgets.dart';
+
+/// The commands the core refuses before they reach the channel (mirrors
+/// `PhoneCore.SHELL_DENY`; listed here so the page is honest about it).
+/// (kind, 标题, 说明) — the seven switches under 拦截危险命令.
+const _categories = <(String, String, String)>[
+  ('uninstall', '卸载 / 清数据', 'pm uninstall、pm clear、pm disable-user、pm revoke'),
+  ('security', '改安全设置', 'settings put secure/global、停用系统组件、伪造开机广播'),
+  ('files', '删文件', 'rm -rf 系统或数据目录、mkfs、dd 写块设备、wipe'),
+  ('power', '关机 / 提权', 'reboot、su'),
+  ('camera', '摄像头', 'appops set … CAMERA、pm grant/revoke …CAMERA、service call … camera'),
+  ('microphone', '麦克风', 'appops set … RECORD_AUDIO、pm grant/revoke …RECORD_AUDIO、service call … audio'),
+  ('location', '位置', 'appops set … LOCATION、pm grant/revoke …LOCATION'),
+  ('partition', '修改系统分区', 'remount、rw 挂载 /system /vendor /product /boot、dd 写 /dev/block、fastboot flash'),
+];
+
+class ShellToolPage extends ConsumerWidget {
+  const ShellToolPage({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final status = ref.watch(phoneProvider).status;
+    final allowed = status.shellAllowed;
+    final guard = status.shellGuard;
+    final ask = status.shellAskBeforeRun;
+    final identity = status.background.shell;
+    final channel = status.background.mode.name;
+    final theme = Theme.of(context);
+    final notifier = ref.read(phoneProvider.notifier);
+
+    return AppPage.list(
+      title: '模型 shell 工具',
+      subtitle: const Text('让 Agent 以 shell 身份在手机上执行命令'),
+      children: [
+        ListPageCard(
+          margin: const EdgeInsets.fromLTRB(16, 12, 16, 12),
+          children: [
+            ListPageRow(
+              icon: Icons.terminal,
+              title: '允许模型使用 shell 工具',
+              subtitle: allowed ? '已允许：模型可以执行 dumpsys / pm / settings 这类命令' : '已禁止：模型拿不到 shell',
+              subtitleMaxLines: 3,
+              onTap: () => unawaited(notifier.setShellAllowed(!allowed)),
+              trailing: Switch(
+                value: allowed,
+                onChanged: (v) => unawaited(notifier.setShellAllowed(v)),
+              ),
+            ),
+          ],
+        ),
+        ListPageCard(
+          margin: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+          children: [
+            ListPageRow(
+              icon: Icons.shield_outlined,
+              title: '拦截危险命令',
+              subtitle: guard ? '开启：下面命中的类别会被直接拒绝' : '已关闭：下面这些命令可以执行，风险自负',
+              subtitleMaxLines: 3,
+              onTap: () => unawaited(notifier.setShellGuard(!guard)),
+              trailing: Switch(
+                value: guard,
+                onChanged: (v) => unawaited(notifier.setShellGuard(v)),
+              ),
+            ),
+          ],
+        ),
+        // 分开关常显：拦截关闭时置灰，让「拦截开 + 类别关 = 放行」这条规则看得见。
+        ListPageCard(
+          margin: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+          title: '拦截哪几类',
+          children: [
+            for (final (kind, label, hint) in _categories)
+              ListPageRow(
+                title: label,
+                subtitle: hint,
+                subtitleMaxLines: 3,
+                onTap: guard
+                    ? () => unawaited(
+                          notifier.setShellGuardCategory(kind, !(status.guardCategories[kind] ?? true)),
+                        )
+                    : null,
+                trailing: Switch(
+                  value: status.guardCategories[kind] ?? true,
+                  onChanged: guard
+                      ? (v) => unawaited(notifier.setShellGuardCategory(kind, v))
+                      : null,
+                ),
+              ),
+            if (!guard)
+              Padding(
+                padding: const EdgeInsets.fromLTRB(16, 4, 16, 12),
+                child: Text(
+                  '拦截已关闭，这七个开关暂时无效。',
+                  style: theme.textTheme.bodySmall?.copyWith(
+                    color: theme.colorScheme.onSurfaceVariant,
+                  ),
+                ),
+              ),
+          ],
+        ),
+        ListPageCard(
+          margin: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+          children: [
+            ListPageRow(
+              icon: Icons.help_outline,
+              title: '执行前询问',
+              // 拦截优先：开着拦截时命中就直接拒绝，不会先问一次。
+              subtitle: guard
+                  ? '拦截已开启：命中类别将直接拒绝，不会询问'
+                  : '只对上面命中的命令询问，其余直接执行',
+              subtitleMaxLines: 3,
+              onTap: guard ? null : () => unawaited(notifier.setShellAskBeforeRun(!ask)),
+              trailing: Switch(
+                // 置灰但仍显示真实值：关掉拦截后这个开关立刻恢复原来的选择。
+                value: ask,
+                onChanged: guard ? null : (v) => unawaited(notifier.setShellAskBeforeRun(v)),
+              ),
+            ),
+          ],
+        ),
+        ListPageCard(
+          margin: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+          title: '当前身份',
+          children: [
+            Padding(
+              padding: const EdgeInsets.fromLTRB(16, 10, 16, 2),
+              child: Text(
+                '当前身份：${identity?.label ?? '未连接'}',
+                style: theme.textTheme.titleSmall,
+              ),
+            ),
+            Padding(
+              padding: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+              child: Text(
+                status.background.ready
+                    ? '特权通道（$channel）已就绪，命令会以这个 UID 执行。'
+                    : '特权通道未就绪：${status.background.reason ?? '未连接'}',
+                style: theme.textTheme.bodySmall?.copyWith(
+                  color: theme.colorScheme.onSurfaceVariant,
+                  height: 1.4,
+                ),
+              ),
+            ),
+            CheckRow(label: '本页开关已允许', done: allowed),
+          ],
+        ),
+        ListPageCard(
+          margin: const EdgeInsets.fromLTRB(16, 0, 16, 12),
+          title: '说明',
+          children: [
+            Padding(
+              padding: const EdgeInsets.fromLTRB(16, 8, 16, 12),
+              child: Text(
+                'shell 身份来自特权通道（Shizuku / Sui / root / 自连 ADB），所以通道关闭时本开关不会有任何效果。\n'
+                '单条命令默认 30 秒超时，最长 300 秒。输出不截断：超过约 26 万字符时，完整内容会写入临时文件并把路径返回。',
+                style: theme.textTheme.bodyMedium?.copyWith(
+                  color: theme.colorScheme.onSurfaceVariant,
+                  height: 1.5,
+                ),
+              ),
+            ),
+          ],
+        ),
+      ],
+    );
+  }
+}
diff --git a/app/lib/ui/plugins/native/chat_plugins_sheet.dart b/app/lib/ui/plugins/native/chat_plugins_sheet.dart
index 0056384b..517cb650 100644
