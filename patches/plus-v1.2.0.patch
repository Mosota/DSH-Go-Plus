diff --git a/app/assets/dshgo/direct/dns.mjs b/app/assets/dshgo/direct/dns.mjs
new file mode 100644
index 00000000..0678ba93
--- /dev/null
+++ b/app/assets/dshgo/direct/dns.mjs
@@ -0,0 +1,175 @@
+// Node's glibc getaddrinfo reads Android's host /etc, not the unpacked guest.
+// Keep dns.lookup's public shape, but resolve through c-ares using the same
+// resolv.conf GuestSetup updates for the proot tools. No host-NSS fallback.
+import dns from 'node:dns';
+import fs from 'node:fs';
+import { dirname } from 'node:path';
+import { isIP } from 'node:net';
+import { networkInterfaces } from 'node:os';
+import { promisify } from 'node:util';
+import { domainToASCII } from 'node:url';
+import { syncBuiltinESMExports } from 'node:module';
+
+const nativeLookup = dns.lookup;
+const nativePromiseLookup = dns.promises.lookup;
+const NOT_FOUND = new Set(['ENODATA', 'ENOTFOUND']);
+const normalizeHost = (name) => name.toLowerCase().replace(/\.$/, '');
+
+export function readDnsConfig(resolvText, hostsText = '') {
+  const servers = [];
+  for (const line of resolvText.split(/\r?\n/u)) {
+    const match = /^\s*nameserver\s+(\S+)/u.exec(line.replace(/[#;].*$/u, ''));
+    if (match && !servers.includes(match[1])) servers.push(match[1]);
+  }
+  if (!servers.length) throw new Error('direct DNS: resolv.conf has no nameserver');
+  const hosts = new Map();
+  for (const line of hostsText.split(/\r?\n/u)) {
+    const [address, ...names] = line.replace(/#.*/u, '').trim().split(/\s+/u);
+    const family = isIP(address ?? '');
+    if (!family) continue;
+    for (const name of names) {
+      const key = normalizeHost(name);
+      const entries = hosts.get(key) ?? [];
+      if (!entries.some((entry) => entry.address === address)) entries.push({ address, family });
+      hosts.set(key, entries);
+    }
+  }
+  return { servers, hosts };
+}
+
+function lookupError(hostname, causes) {
+  const code = causes.some((error) => !NOT_FOUND.has(error?.code)) ? 'EAI_AGAIN' : 'ENOTFOUND';
+  return Object.assign(new Error(`getaddrinfo ${code} ${hostname}`), {
+    code, errno: code, syscall: 'getaddrinfo', hostname,
+  });
+}
+
+/**
+ * Independent resolvers per process/worker, one per address family. Both A and
+ * AAAA are queried for family=0. `verbatim` preserves each RR response's order,
+ * A then AAAA: c-ares cannot reproduce NSS's cross-family ordering. The app
+ * default is ipv4first.
+ * The returned refresh/close seams are also used by the local UDP tests.
+ */
+export function createLookup({ resolvConf, hostsFile, Resolver = dns.Resolver, watch = true } = {}) {
+  let current;
+  let configurationError;
+  const refresh = () => {
+    try {
+      const config = readDnsConfig(fs.readFileSync(resolvConf, 'utf8'), fs.readFileSync(hostsFile, 'utf8'));
+      const resolver = () => {
+        const instance = new Resolver({ timeout: 2000, tries: 2 });
+        instance.setServers(config.servers);
+        return instance;
+      };
+      // One c-ares channel per family: a network that rejects every AAAA send
+      // must not fail the A query sharing its channel (#55, #152).
+      // In-flight requests retain their old resolvers. Never cancel another lookup.
+      current = { ...config, resolvers: { 4: resolver(), 6: resolver() } };
+      configurationError = undefined;
+    } catch (error) {
+      configurationError = error;
+      if (!current) throw error;
+    }
+  };
+  refresh();
+  let watcher;
+  if (watch) {
+    watcher = fs.watch(dirname(resolvConf), { persistent: false }, (_event, filename) => {
+      if (filename == null || ['resolv.conf', 'hosts'].includes(String(filename))) refresh();
+    });
+    watcher.on('error', (error) => { configurationError = error; });
+  }
+
+  async function resolve(hostname, options) {
+    // A failed config read can recover without another event; a dead watcher cannot.
+    if (configurationError && configurationError.syscall !== 'watch') refresh();
+    if (configurationError) throw lookupError(hostname, [{ code: 'ESERVFAIL' }]);
+    const snapshot = current;
+    const family = options.family === 'IPv4' ? 4 : options.family === 'IPv6' ? 6 : (options.family ?? 0);
+    const hints = options.hints ?? 0;
+    let families = family ? [family] : [4, 6];
+    const mapped = family === 6 && Boolean(hints & dns.V4MAPPED);
+    if (mapped) families.push(4);
+    if (hints & dns.ADDRCONFIG) {
+      // Loopback alone does not establish Internet reachability. A platform that
+      // denies getifaddrs cannot safely infer which family to suppress.
+      try {
+        const entries = Object.values(networkInterfaces()).flat();
+        // Loopback-only enumeration (proot/proroot always answers just `lo`) says
+        // nothing about reachability: filtering on it leaves no family at all and
+        // every lookup fails with ENOTFOUND. Only narrow when a real, non-loopback
+        // interface was seen.
+        const available = new Set(entries.filter((e) => e && !e.internal)
+          .map((e) => e.family === 'IPv6' || e.family === 6 ? 6 : 4));
+        if (available.size > 0) {
+          families = families.filter((value) => available.has(value));
+        }
+      } catch { /* retain both families when Android denies interface enumeration */ }
+    }
+    const hostEntries = snapshot.hosts.get(normalizeHost(hostname));
+    const failures = [];
+    let answers;
+    if (hostEntries) answers = hostEntries.filter((entry) => families.includes(entry.family))
+      .map(({ address, family }) => ({ address, family }));
+    else {
+      const responses = await Promise.all(families.map((value) => new Promise((done) => {
+        snapshot.resolvers[value][value === 4 ? 'resolve4' : 'resolve6'](domainToASCII(hostname) || hostname, (error, addresses) => {
+          if (error) { failures.push(error); done([]); }
+          else done(addresses.map((address) => ({ address, family: value })));
+        });
+      })));
+      answers = responses.flat();
+    }
+    if (mapped) {
+      const ipv6 = answers.filter((entry) => entry.family === 6);
+      const ipv4 = answers.filter((entry) => entry.family === 4);
+      answers = [...ipv6, ...(!ipv6.length || (hints & dns.ALL) ? ipv4.map((entry) => ({
+        address: `::ffff:${entry.address}`, family: 6,
+      })) : [])];
+    }
+    const order = options.order ?? (options.verbatim === undefined ? dns.getDefaultResultOrder()
+      : options.verbatim ? 'verbatim' : 'ipv4first');
+    if (order !== 'verbatim') answers.sort((a, b) => order === 'ipv6first' ? b.family - a.family : a.family - b.family);
+    if (!answers.length) throw lookupError(hostname, failures);
+    return answers;
+  }
+
+  function lookup(hostname, options, callback) {
+    if (typeof options === 'function') { callback = options; options = undefined; }
+    // This IP-only call delegates option/callback validation to the exact Node
+    // version in the runtime and performs no DNS/network access.
+    nativeLookup('127.0.0.1', options, typeof callback === 'function' ? () => {} : callback);
+    if (!hostname || typeof hostname !== 'string' || hostname.includes('\0') || isIP(hostname)) {
+      return nativeLookup(hostname, options, callback);
+    }
+    const parsed = typeof options === 'number' ? { family: options } : (options ?? {});
+    resolve(hostname, parsed).then(
+      (answers) => parsed.all ? process.nextTick(callback, null, answers)
+        : process.nextTick(callback, null, answers[0].address, answers[0].family),
+      (error) => process.nextTick(callback, error),
+    );
+    return {};
+  }
+  function callbackPromise(hostname, options) {
+    return new Promise((fulfill, reject) => lookup(hostname, options, (error, address, family) => {
+      if (error) reject(error);
+      else fulfill(Array.isArray(address) ? address : { address, family });
+    }));
+  }
+  async function promiseLookup(hostname, options) {
+    // Node 24's Promise API validates family more strictly than callback lookup.
+    await nativePromiseLookup('127.0.0.1', options);
+    return callbackPromise(hostname, options);
+  }
+  lookup[promisify.custom] = callbackPromise;
+  return { lookup, promiseLookup, refresh, close: () => watcher?.close() };
+}
+
+export function installLookup(options) {
+  const adapter = createLookup(options);
+  dns.lookup = adapter.lookup;
+  dns.promises.lookup = adapter.promiseLookup;
+  syncBuiltinESMExports();
+  return adapter;
+}
diff --git a/app/assets/web/dsh_mobile.css b/app/assets/web/dsh_mobile.css
new file mode 100644
index 00000000..edc023d4
--- /dev/null
+++ b/app/assets/web/dsh_mobile.css
@@ -0,0 +1,391 @@
+/* ============================================================
+   deepdive 手机版 UI 优化 v0.3（对应 APK v1.3.1）
+   ------------------------------------------------------------
+   ⚠️ 0.1.7 内核升级（APK v1.15.0）后的重大变更：选择器改为【属性选择器】。
+   - 原来写的是 Vite 哈希类名（._wrap_1ao1y_1 = _名字_hash_行号）。
+     前端每次重新构建，hash 必然变 → 0.1.7 升级后实测 **20 个选择器全部失效（0 命中）**，
+     整套移动端适配静默失效。
+   - 现统一改为 [class*="_名字_"]：只要前端还叫这个名字（hash/行号变了也无所谓）就继续生效。
+     属性选择器特异性与类选择器相同（0,1,0），不会改变原有优先级。
+   - 已核对 0.1.7 前端：15 个名字仍存在（answer/block/button/card/command/content/
+     input/item/itemLabel/label/line/markdown/output/separator/wrap）。
+   - ⚠️ 4 个名字在新前端已不存在（gallery / illustration / rail / thumbnail，
+     对应附件缩略图栏与图片画廊，这两个组件在 0.1.7 被重构）→ 已删除。
+   - ⚠️ **但「名字存在」≠「可以随便改」**：`_item_` / `_label_` / `_separator_` /
+     `_itemLabel_` 这四个名字在 0.1.7 命中的是【菜单/下拉菜单】组件，
+     不是当年那个侧栏图标行 → 详见下方「v1.15.1 修正」。
+   ------------------------------------------------------------
+   v0.2 重写说明（历史）：
+   - 旧版 mobile.css 使用的类名（gdEzaW_/hHd-Xa_/pbvGtq_/qSYn7G_ 等）
+     在真实前端构建中不存在，属"死代码"；当时改为 0.1.0-rc.6 的真实哈希类名（已废弃）。
+   - 新增：竖屏适配（原 APK 锁横屏）、鲸鱼蓝皮肤、触摸优化。
+   v0.3 新增（v1.3.1，全部为布局/溢出修复，不删功能）：
+   - 消息操作条多行换行（.p-xYUq_actions flex-wrap）
+   - 标题栏让位三条杠（.wSkVaW_header padding-left:52px）
+   - 正文/输入框扩宽（消息区 padding 32→8px、composer 边距 16/8→4px）
+   - 滚动条不占位（scrollbar-gutter:auto）→ 修输入栏按钮重叠
+   - Bash 工具卡片防横向溢出（pre-wrap + word-break）
+   - 后台任务菜单右对齐（.QsffPG_menu right:0）
+   - 设置页单栏（.VOzbGW_panel 上下排列 + 内容可滚动）
+   - 插件按钮定位到三条杠下方（[data-cordis-badge] fixed 52/8，不动 DOM）
+   注意：类名是运行时插件动态注入的 CSS module 类名，改前先确认真实类名。
+   ============================================================ */
+
+:root {
+  /* 触摸友好：点击目标最小 44px */
+  --ds-mobile-tap: 44px;
+  /* 鲸鱼蓝皮肤（与桌面版 deepdive 一致） */
+  --dsw-alias-brand-primary: #4D6BFE !important;
+  --dsw-alias-brand-primary-hover: #5B7CFF !important;
+  --dsw-alias-brand-primary-active: #3D5AE8 !important;
+}
+[data-ds-dark-theme] {
+  --dsw-alias-brand-primary: #4D6BFE !important;
+  --dsw-alias-brand-primary-hover: #5B7CFF !important;
+  --dsw-alias-brand-primary-active: #3D5AE8 !important;
+}
+
+/* ---------- 基础触摸优化 ---------- */
+button,
+[role="button"],
+.icon-btn,
+input,
+select,
+textarea {
+  -webkit-tap-highlight-color: transparent;
+  touch-action: manipulation;
+}
+
+/* 16px 防止聚焦时页面缩放 */
+textarea,
+input[type="text"],
+input[type="search"] {
+  font-size: 16px !important;
+}
+
+/* 触屏滚动条更细 */
+::-webkit-scrollbar {
+  width: 4px;
+  height: 4px;
+}
+::-webkit-scrollbar-thumb {
+  border-radius: 4px;
+}
+
+/* ---------- 真实类名适配 ---------- */
+
+/* 输入框/搜索框：加大点击与输入区 */
+[class*="_wrap_"] {
+  height: 44px;
+  min-height: 44px;
+  border-radius: 12px;
+  padding: 0 12px;
+}
+[class*="_input_"] {
+  font-size: 16px !important;
+  line-height: 28px;
+}
+
+/* ⚠ v1.15.1 已删除（原「侧栏图标行」与「菜单项」）：
+   [class*="_rail_"] { gap: 12px }
+   [class*="_item_"] { flex: 0 0 48px; width: 48px; height: 48px }
+   [class*="_item_"] { min-height: 40px }
+   [class*="_thumbnail_"] { width/height: 48px; border-radius: 14px }
+   [class*="_label_"] { padding: 6px 4px }
+   删除原因见本文件头部「v1.15.1 修正」。 */
+
+/* 消息/回答内容：移动端全宽阅读，不挤压 */
+[class*="_answer_"],
+[class*="_markdown_"],
+[class*="_content_"] {
+  max-width: 100% !important;
+}
+
+/* 工具调用卡片：全宽 + 可读性 */
+[class*="_block_"],
+[class*="_output_"],
+[class*="_command_"] {
+  max-width: 100% !important;
+}
+
+/* 表格：窄屏可横向滚动
+   注：类名哈希随前端构建变化（_tableScroll_1nba0 → _tableScroll_1r4m5），
+   改用属性选择器匹配，避免前端更新后失效；同时覆盖前端 md-table-wide
+   的「hover 才显示滚动条」设计——触屏设备没有 hover，滚动条永远隐藏
+   导致宽表格无法横向滑动。移动端始终允许横向滚动。 */
+[class*="tableScroll"],
+.md-table-wide {
+  max-width: 100% !important;
+  overflow-x: auto !important;
+  -webkit-overflow-scrolling: touch;
+  overscroll-behavior-x: contain;
+  padding-bottom: 0 !important;
+}
+
+/* 空状态 / 引导卡：宽度自适应
+   （原 [class*="_gallery_"] / [class*="_illustration_"] 在 0.1.7 已无同名组件，已删） */
+[class*="_card_"] {
+  max-width: 100% !important;
+}
+
+/* ============ 竖屏专项适配 ============ */
+@media (orientation: portrait) {
+  html,
+  body {
+    font-size: 15.5px;
+  }
+
+  /* 会话/回答内容宽度：竖屏给足空间 */
+  [class*="_answer_"],
+  [class*="_markdown_"] {
+    width: 100%;
+    max-width: 100% !important;
+  }
+
+  /* 工具卡片、代码块：竖屏不横向溢出 */
+  [class*="_block_"],
+  [class*="_output_"],
+  [class*="_content_"] {
+    width: 100% !important;
+    max-width: 100% !important;
+  }
+
+  /* 底部输入区：触摸目标更大、更易点击 */
+  [class*="_wrap_"] {
+    height: 48px;
+    border-radius: 14px;
+  }
+  [class*="_input_"] {
+    font-size: 16px !important;
+  }
+
+  /* 侧栏图标（_rail_/_item_/_thumbnail_）规则已按头部「v1.15.1 修正」删除：
+     0.1.7 的 _item_ 是菜单项组件，强制 44×44 会把菜单文字裁掉。 */
+}
+
+/* ============ 设置页移动端优化（基于真机截图） ============ */
+@media (max-width: 1100px) {
+  /* 设置菜单项尺寸（_item_/_itemLabel_/_label_/_separator_）规则已按头部「v1.15.1 修正」删除：
+     这四个名字在 0.1.7 都命中菜单/下拉菜单组件，会改坏菜单宽度与标签内边距。 */
+
+  /* 设置说明文字：行距舒展，不再挤成竖排 */
+  p,
+  li,
+  dd,
+  dt {
+    line-height: 1.75;
+  }
+
+  /* 顶部操作按钮（如"打开配置文件"）更大更好点 */
+  [class*="_button_"] {
+    min-height: 40px;
+    padding: 8px 14px;
+  }
+}
+
+/* ============ 横屏矮屏（窄高度）优化 ============ */
+@media (max-height: 520px) and (orientation: landscape) {
+  html,
+  body {
+    font-size: 14.5px;
+  }
+  /* _rail_/_item_/_thumbnail_ 规则已按头部「v1.15.1 修正」删除 */
+}
+
+/* ============ 窄屏：AI 消息操作条分多行 ============
+   MessageIconActions（复制/赞踩/分支/时间/耗时/token）原为一行
+   flex（height:28px、文字 nowrap），窄屏下会伸出屏幕；
+   改为允许换行：时间/耗时为整体单元，放不下就折到下一行。
+   !important 是为了压过插件运行时注入的同名规则（注入顺序在后）。 */
+@media (max-width: 640px) {
+  .p-xYUq_actions {
+    flex-wrap: wrap !important;
+    height: auto !important;
+    min-height: 28px;
+    row-gap: 2px;
+  }
+  .p-xYUq_timeStart,
+  .p-xYUq_timeEnd {
+    white-space: normal !important;
+  }
+}
+
+/* ============ 窄屏：会话标题栏给左上角三条杠让位 ============
+   聊天区顶部 header（会话标题/面包屑）默认左 padding 20px，
+   会被 fixed 在左上角（8px 起、宽 36px）的三条杠按钮盖住；
+   窄屏下把标题栏左内边距加大，让标题从三条杠右侧开始。 */
+@media (max-width: 640px) {
+  .wSkVaW_header {
+    padding-left: 52px !important;
+  }
+}
+
+/* ============ 窄屏：正文与输入框扩宽 ============
+   桌面端为三列布局预留了大量左右内缩（消息区 padding 32px、
+   输入框 clearance 16+inset 8 = 24px），窄屏（竖屏/手机横屏）下
+   白白浪费宽度。这里把内缩收小，让正文与输入栏更宽；
+   同时滚动条不预留占位（避免输入栏被压窄导致按钮重叠）。 */
+@media (max-width: 640px) {
+  /* 正文消息区：左右内缩 32px → 8px */
+  .Md3f7G_scroll {
+    padding-left: 8px !important;
+    padding-right: 8px !important;
+  }
+  /* 输入框 dock 更宽：clearance/inset 收小 */
+  .wSkVaW_root {
+    --dsh-composer-side-clearance: 4px !important;
+    --dsh-composer-dock-inset: 4px !important;
+  }
+  /* 滚动条不占宽度，避免压缩输入栏（有会话时按钮重叠的根因） */
+  .wSkVaW_scrollBody,
+  .Md3f7G_scroll {
+    scrollbar-gutter: auto !important;
+  }
+  /* 工具调用卡片：不贴屏幕左右边缘 */
+  [class*="_block_"],
+  [class*="_output_"],
+  [class*="_content_"] {
+    margin-left: 2px !important;
+    margin-right: 2px !important;
+  }
+}
+
+/* ============ 窄屏：输入栏右侧按钮保持一行且不重叠 ============
+   InputBar 的 trailing 一行排开（审核模式按钮 + 模型名 + token 计量），
+   窄屏下直接换行会让审核按钮掉到下一行、输入框变高；
+   这里保持一行（nowrap），通过压缩模型名宽度与按钮间距避免重叠。 */
+@media (max-width: 640px) {
+  .uV2eYG_trailing,
+  .uV2eYG_modes,
+  .uV2eYG_tools {
+    flex-wrap: nowrap !important;
+  }
+  .uV2eYG_trailing,
+  .uV2eYG_modes {
+    gap: 6px !important;
+  }
+  .uV2eYG_select {
+    max-width: 26vw !important;
+    font-size: 12px !important;
+  }
+}
+
+/* ============ 窄屏：Bash 工具卡片防横向溢出 ============
+   终端卡片里的命令文本/输出行 white-space:pre 不换行，
+   窄屏下会把卡片撑出屏幕；改为可换行（pre-wrap）。 */
+@media (max-width: 640px) {
+  [class*="_command_"],
+  [class*="_line_"] {
+    white-space: pre-wrap !important;
+    word-break: break-all;
+  }
+  [class*="_block_"] {
+    max-width: 100% !important;
+    box-sizing: border-box;
+  }
+}
+
+/* ============ 插件按钮（mobile.js 注入，三条杠下方） ============
+   窄屏下侧边栏里的插件入口不易触达，改为左上角三条杠下方的
+   图标按钮（fixed 定位由 JS 设置）；点击打开插件管理面板。 */
+.dsh-mobile-plugin-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  padding: 0;
+  border: none;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--dsw-alias-label-secondary, #8b98a9);
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+  touch-action: manipulation;
+}
+.dsh-mobile-plugin-btn:active {
+  background: var(--dsw-alias-interactive-bg-hover, rgba(255, 255, 255, 0.08));
+  color: var(--dsw-alias-label-primary, #e6edf3);
+}
+.dsh-mobile-plugin-btn svg {
+  display: block;
+  width: 16px;
+  height: 16px;
+}
+
+/* ============ 窄屏：插件按钮定位到三条杠下方 ============
+   核心渲染的插件按钮（header.utilities 里的 [data-cordis-badge]，
+   单一实例）默认在右上角；CSS position:fixed 挪到左上角三条杠
+   正下方。不动 DOM（按钮留在 #root 内，React 事件委托才有效），
+   只改样式；隐藏宽版按钮文字，只留图标。 */
+@media (max-width: 1024px) {
+  .wSkVaW_headerUtilities [data-cordis-badge] {
+    position: fixed !important;
+    top: 52px !important;
+    left: 8px !important;
+    width: 32px !important;
+    height: 32px !important;
+    margin: 0 !important;
+    padding: 0 6px !important;
+    gap: 4px !important;
+    border-radius: 8px !important;
+    font-size: 12px !important;
+    z-index: 1000 !important;
+    background: transparent !important;
+  }
+  .wSkVaW_headerUtilities [data-cordis-badge] > span {
+    display: none !important;
+  }
+}
+
+/* ============ 窄屏：后台任务菜单不超出屏幕 ============
+   后台任务下拉（.QsffPG_menu）定位 left:0，按钮在右侧时面板
+   向右延伸超出屏幕（任务名被推到屏外）；改为右对齐向左展开。 */
+@media (max-width: 640px) {
+  .QsffPG_menu {
+    left: auto !important;
+    right: 0 !important;
+    max-width: calc(100vw - 24px) !important;
+  }
+}
+
+/* ============ 窄屏：设置页单栏适配 ============
+   设置页（.VOzbGW_panel）默认 800px 左右两栏（nav 188px + 内容），
+   竖屏下内容列被挤到一百多像素、几乎不可用；
+   改为上下排列：导航横排（可横向滚动）在顶部，内容区全宽在下。 */
+@media (max-width: 640px) {
+  .VOzbGW_panel {
+    flex-direction: column !important;
+    width: 100% !important;
+    max-width: calc(100vw - 16px) !important;
+    height: min(800px, calc(100vh - 32px)) !important;
+    border-radius: 16px !important;
+  }
+  .VOzbGW_nav {
+    width: 100% !important;
+    flex-direction: row !important;
+    align-items: center !important;
+    gap: 8px !important;
+    padding: 10px 8px 0 !important;
+    overflow-x: auto !important;
+  }
+  .VOzbGW_navTitle {
+    flex: none !important;
+    white-space: nowrap !important;
+  }
+  .VOzbGW_navList {
+    flex-direction: row !important;
+    gap: 4px !important;
+  }
+  .VOzbGW_navCell {
+    flex: none !important;
+    white-space: nowrap !important;
+    height: 36px !important;
+    padding: 6px 12px !important;
+  }
+  .VOzbGW_content {
+    flex: 1 !important;
+    overflow-y: auto !important;
+    min-height: 0 !important;
+  }
+}
diff --git a/app/assets/web/dsh_web_phone.js b/app/assets/web/dsh_web_phone.js
index 2b7b04a1..972c0c91 100644
--- a/app/assets/web/dsh_web_phone.js
+++ b/app/assets/web/dsh_web_phone.js
@@ -12,6 +12,20 @@
 // is one transform on the compositor.
 (function () {
   if (window.__dshApp) return;
+
+  // 手机适配的第 0 步:viewport。没有它,Android WebView 会先按桌面宽度排一次
+  // 版,页面自己的断点和下面这套手机 CSS 都可能按桌面尺寸算;补上之后
+  // width=device-width 才让 760/1024 这些断点真的落在手机宽度上。
+  var viewport = document.querySelector('meta[name="viewport"]');
+  if (!viewport) {
+    viewport = document.createElement('meta');
+    viewport.setAttribute('name', 'viewport');
+    document.head.appendChild(viewport);
+  }
+  if ((viewport.getAttribute('content') || '').indexOf('width=device-width') < 0) {
+    viewport.setAttribute('content', 'width=device-width, initial-scale=1, viewport-fit=cover');
+  }
+
   // Install the display default only here, before the page's styles. Declaring
   // it first in the appended phone CSS would give it a later layer position.
   var defaults = document.createElement('style');
