diff --git a/app/lib/ui/phone/background_advanced.dart b/app/lib/ui/phone/background_advanced.dart
new file mode 100644
index 00000000..3e16aca7
--- /dev/null
+++ b/app/lib/ui/phone/background_advanced.dart
@@ -0,0 +1,154 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../l10n/l10n.dart';
+import '../../phone/phone_channel.dart';
+import '../../state/phone_state.dart';
+import '../common/brief_notice.dart';
+import '../common/list_page_row.dart';
+import '../shell/page_frame.dart';
+import '../theme/app_icons.dart';
+import '../theme/theme.dart';
+import 'phone_widgets.dart';
+
+/// 后台屏的高级设置：保持通道、并行槽位、视口、使用前提。
+///
+/// 这些参数属于「特权通道 / 后台屏」，不属于虚拟屏的显示开关，所以放在特权通道页。
+class PhoneAdvancedSettings extends ConsumerStatefulWidget {
+  const PhoneAdvancedSettings({super.key});
+
+  @override
+  ConsumerState<PhoneAdvancedSettings> createState() => _PhoneAdvancedSettingsState();
+}
+
+class _PhoneAdvancedSettingsState extends ConsumerState<PhoneAdvancedSettings> {
+  static const _groupMargin = EdgeInsets.fromLTRB(16, 12, 16, 12);
+
+  bool _busy = false;
+
+  Future<void> _run(Future<PhoneResult> Function() action) async {
+    if (_busy) return;
+    setState(() => _busy = true);
+    try {
+      final result = await action();
+      if (!mounted) return;
+      if (!result.ok) showBriefNotice(context, result.reason ?? context.l10n.phoneActionFailedLater);
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Widget _keepRow(PhonePrivilegedMode mode, PhonePrivilegedKeepStatus keep) {
+    final l10n = context.l10n;
+    final controller = ref.read(phoneProvider.notifier);
+    void toggle(bool on) => unawaited(_run(() => controller.setBackgroundKeep(mode, on)));
+    return MergeSemantics(
+      child: ListPageRow(
+        leading: const SizedBox(),
+        title: l10n.phoneKeepTitle(mode.name),
+        titleMaxLines: 2,
+        subtitle: switch (mode) {
+          PhonePrivilegedMode.root => l10n.phoneKeepRootDescription,
+          PhonePrivilegedMode.adb => l10n.phoneKeepAdbDescription,
+          _ => l10n.phoneKeepSharedDescription,
+        },
+        subtitleMaxLines: 8,
+        onTap: _busy ? null : () => toggle(!keep.enabled),
+        trailing: Switch(value: keep.enabled, onChanged: _busy ? null : toggle),
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = context.l10n;
+    final status = ref.watch(phoneProvider).status;
+    final bg = status.background;
+    final using = bg.effectiveMode;
+    final controller = ref.read(phoneProvider.notifier);
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        if (using != PhonePrivilegedMode.off && bg.privileged != null)
+          ListPageCard(margin: _groupMargin, children: [_keepRow(using, bg.keep)]),
+        if (bg.parallelism case final capacity? when status.ready)
+          ListPageCard(
+            margin: _groupMargin,
+            title: l10n.phoneBackgroundParallelTitle,
+            children: [
+              ListPageRow(
+                title: l10n.phoneBackgroundParallelStatus(
+                  capacity.configuredLimit,
+                  capacity.effectiveLimit,
+                  capacity.heldSlots,
+                ),
+                titleMaxLines: 4,
+                subtitle: switch (capacity.reason) {
+                  'off' => l10n.phoneBackgroundParallelOff,
+                  'unsupported' => l10n.phoneBackgroundParallelUnsupported,
+                  'connectionRequired' => l10n.phoneBackgroundParallelConnection,
+                  'busy' => l10n.phoneBackgroundParallelBusy,
+                  'transportSerial' => l10n.phoneBackgroundParallelSerial,
+                  _ => l10n.phoneBackgroundParallelDescription,
+                },
+                subtitleMaxLines: 5,
+              ),
+              for (final limit in const [1, 2, 3])
+                Semantics(
+                  selected: capacity.configuredLimit == limit,
+                  inMutuallyExclusiveGroup: true,
+                  child: ListPageRow(
+                    key: ValueKey('phone-background-limit-$limit'),
+                    leading: Icon(capacity.configuredLimit == limit ? AppIcons.radioOn : AppIcons.radioOff),
+                    title: l10n.phoneBackgroundParallelChoice(limit),
+                    onTap: _busy || capacity.configuredLimit == limit
+                        ? null
+                        : () => unawaited(_run(() => controller.setBackgroundParallelLimit(limit))),
+                  ),
+                ),
+            ],
+          ),
+        if (bg.viewport case final viewport? when bg.androidOk)
+          ListPageCard(
+            margin: _groupMargin,
+            title: l10n.phoneViewportTitle,
+            children: [
+              ListPageRow(leading: const SizedBox(), title: l10n.phoneViewportDescription, titleMaxLines: 10),
+              for (final preset in PhoneBackgroundViewport.values)
+                Semantics(
+                  selected: viewport == preset,
+                  inMutuallyExclusiveGroup: true,
+                  child: ListPageRow(
+                    key: ValueKey('phone-viewport-${preset.name}'),
+                    leading: Icon(viewport == preset ? AppIcons.radioOn : AppIcons.radioOff),
+                    title: preset == PhoneBackgroundViewport.portrait
+                        ? l10n.phoneViewportPortrait
+                        : l10n.phoneViewportLandscape,
+                    onTap: _busy || viewport == preset
+                        ? null
+                        : () => unawaited(_run(() => controller.setBackgroundViewport(preset))),
+                  ),
+                ),
+            ],
+          ),
+        ListPageCard(
+          margin: _groupMargin,
+          title: l10n.phoneDndRequirements,
+          children: [
+            BulletLines([
+              l10n.phoneDndKeepUnlocked,
+              if (!bg.keep.enabled) l10n.phoneDndReactivate,
+              if (using == PhonePrivilegedMode.off ||
+                  using == PhonePrivilegedMode.shizuku ||
+                  using == PhonePrivilegedMode.adb)
+                l10n.phoneDndKeepDebugging,
+            ]),
+          ],
+        ),
+      ],
+    );
+  }
+}
diff --git a/app/lib/ui/phone/ball_settings_page.dart b/app/lib/ui/phone/ball_settings_page.dart
new file mode 100644
index 00000000..fec99ac8
--- /dev/null
+++ b/app/lib/ui/phone/ball_settings_page.dart
@@ -0,0 +1,293 @@
+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../state/phone_state.dart';
+import '../common/list_page_row.dart';
+import '../shell/page_frame.dart';
+import '../theme/app_icons.dart';
+import 'phone_widgets.dart';
+
+const _groupMargin = EdgeInsets.fromLTRB(16, 12, 16, 12);
+
+/// 悬浮球: the ball that floats over other apps while 虚拟屏's picture window is
+/// closed, and what it looks like. The settings live on the native side
+/// (VscreenBallPrefs.kt); a showing ball follows each change at once.
+class PhoneBallSettingsPage extends ConsumerStatefulWidget {
+  const PhoneBallSettingsPage({super.key});
+
+  @override
+  ConsumerState<PhoneBallSettingsPage> createState() => _PhoneBallSettingsPageState();
+}
+
+class _PhoneBallSettingsPageState extends ConsumerState<PhoneBallSettingsPage> with WidgetsBindingObserver {
+  /// Null until the native side answers (or forever, without it: the reason the
+  /// rows are off).
+  PhoneBallPrefs? _prefs;
+
+  /// The ball's real state, from [PhoneBallPrefs.showing] — the service's own answer,
+  /// not this run's last request (its 关闭 row can take it away while this page is open).
+  bool _showing = false;
+  bool _busy = false;
+  bool _syncing = false;
+
+  /// Set between a tap and the service having had time to answer: the poll must not race the
+  /// start and flip the switch back before the ball window is there.
+  bool _hold = false;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    unawaited(_load());
+    // The ball floats over this very page, so closing it from its own menu never pauses
+    // the app: a light poll is what keeps 显示悬浮球 honest while the page stays open.
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) unawaited(_load());
+  }
+
+  Future<void> _load() async {
+    final prefs = await ref.read(phoneProvider.notifier).ballPrefs();
+    if (!mounted || prefs == null) return;
+    _apply(prefs);
+  }
+
+  /// 显示悬浮球 follows the service, never a local flag; the sliders keep the values this
+  /// page has just written, so only the switch is taken from here.
+  Future<void> _syncShowing() async {
+    if (!mounted || _busy || _syncing || _hold) return;
+    _syncing = true;
+    try {
+      final prefs = await ref.read(phoneProvider.notifier).ballPrefs();
+      if (!mounted || prefs == null) return;
+      ref.read(vscreenBallProvider.notifier).update(prefs.showing);
+      if (prefs.showing == _showing) return;
+      setState(() => _showing = prefs.showing);
+    } finally {
+      _syncing = false;
+    }
+  }
+
+  void _apply(PhoneBallPrefs prefs) {
+    // A ball opened from the 虚拟屏 window's 关闭 (or still up from last time) is on,
+    // whatever this run of the app has done so far.
+    ref.read(vscreenBallProvider.notifier).update(prefs.showing);
+    setState(() {
+      _prefs = prefs;
+      _showing = prefs.showing;
+    });
+  }
+
+  Future<void> _setShowing(bool on) async {
+    if (_busy) return;
+    setState(() {
+      _busy = true;
+      _hold = true;
+      // The request, until the service answers; the poll settles it either way.
+      _showing = on;
+    });
+    final phone = ref.read(phoneProvider.notifier);
+    final result = on ? await phone.openBallOverlay() : await phone.closeBallOverlay();
+    if (!mounted) return;
+    setState(() {
+      _busy = false;
+      if (!on || !result.ok) _showing = false;
+    });
+    if (on && !result.ok) {
+      final text = result.reasonCode == 'noOverlayPermission' ? '请允许显示在其他应用上层' : (result.reason ?? '悬浮球打不开');
+      ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(text)));
+    }
+    // A start is asynchronous: let the service settle, then take its answer again.
+    unawaited(Future<void>.delayed(const Duration(milliseconds: 600), _releaseHold));
+  }
+
+  void _releaseHold() {
+    if (!mounted) return;
+    _hold = false;
+    unawaited(_syncShowing());
+  }
+
+  /// The page shows the change at once and sends it on, as the 悬浮条's rows do.
+  Future<void> _write(PhoneBallPrefs next) async {
+    if (next == _prefs) return;
+    setState(() => _prefs = next);
+    await ref.read(phoneProvider.notifier).setBallPrefs(
+      sizeDp: next.sizeDp,
+      opacity: next.opacity,
+      idleHide: next.idleHide,
+      idleMs: next.idleMs,
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final prefs = _prefs;
+    final showing = _showing;
+
+    return AppPage.list(
+      title: '悬浮球',
+      subtitle: const Text('浮在任意界面上的小球，一点就能看虚拟屏'),
+      children: [
+        ListPageCard(
+          margin: _groupMargin,
+          children: [
+            MergeSemantics(
+              child: ListPageRow(
+                icon: AppIcons.overlayBall,
+                title: '显示悬浮球',
+                subtitle: '需要「显示在其他应用上层」',
+                onTap: prefs == null || _busy ? null : () => unawaited(_setShowing(!showing)),
+                trailing: Switch(
+                  value: showing,
+                  onChanged: prefs == null || _busy ? null : (v) => unawaited(_setShowing(v)),
+                ),
+              ),
+            ),
+          ],
+        ),
+        if (prefs != null) ...[
+          ListPageCard(
+            margin: _groupMargin,
+            title: '外观',
+            children: [
+              _BallSliderRow(
+                icon: AppIcons.swap,
+                title: '大小',
+                label: '${prefs.sizeDp} dp',
+                value: prefs.sizeDp.toDouble(),
+                min: PhoneBallPrefs.minSizeDp.toDouble(),
+                max: PhoneBallPrefs.maxSizeDp.toDouble(),
+                step: 4,
+                onChanged: (v) => unawaited(_write(prefs.copyWith(sizeDp: v.round()))),
+              ),
+              _BallSliderRow(
+                icon: AppIcons.overlayOpacity,
+                title: '不透明度',
+                label: '${prefs.percent}%',
+                value: prefs.percent.toDouble(),
+                min: (PhoneBallPrefs.minOpacity * 100).round().toDouble(),
+                max: (PhoneBallPrefs.maxOpacity * 100).round().toDouble(),
+                step: 5,
+                onChanged: (v) => unawaited(_write(prefs.copyWith(opacity: v / 100))),
+              ),
+            ],
+          ),
+          ListPageCard(
+            margin: _groupMargin,
+            title: '闲置',
+            children: [
+              MergeSemantics(
+                child: ListPageRow(
+                  icon: AppIcons.queued,
+                  title: '闲置后自动半隐',
+                  subtitle: '没有碰它时滑出屏幕一半，再点一下回来',
+                  onTap: () => unawaited(_write(prefs.copyWith(idleHide: !prefs.idleHide))),
+                  trailing: Switch(
+                    value: prefs.idleHide,
+                    onChanged: (v) => unawaited(_write(prefs.copyWith(idleHide: v))),
+                  ),
+                ),
+              ),
+              _BallSliderRow(
+                icon: AppIcons.alarmClock,
+                title: '闲置秒数',
+                label: '${prefs.idleSeconds} 秒',
+                value: prefs.idleSeconds.toDouble(),
+                min: (PhoneBallPrefs.minIdleMs / 1000).roundToDouble(),
+                max: (PhoneBallPrefs.maxIdleMs / 1000).roundToDouble(),
+                step: 1,
+                onChanged: prefs.idleHide ? (v) => unawaited(_write(prefs.copyWith(idleMs: v.round() * 1000))) : null,
+              ),
+            ],
+          ),
+          const PageFootnote('球总是贴着屏幕的左右边；拖到哪边，它就在哪边停。关掉「显示悬浮球」会把它收起来，虚拟屏本身不受影响。'),
+        ] else
+          const PageFootnote('原生模块还没就绪，暂时读不到悬浮球的设置。'),
+      ],
+    );
+  }
+}
+
+/// 大小 / 不透明度 / 闲置秒数: the row with its value, the slider under the title
+/// (from the title's left edge to the value's right one), neutral like every
+/// slider in settings. A null [onChanged] greys it out.
+class _BallSliderRow extends StatelessWidget {
+  const _BallSliderRow({
+    super.key,
+    required this.icon,
+    required this.title,
+    required this.label,
+    required this.value,
+    required this.min,
+    required this.max,
+    required this.step,
+    required this.onChanged,
+  });
+
+  final IconData icon;
+  final String title;
+
+  /// The value as the row shows it ("56 dp", "80%", "3 秒").
+  final String label;
+  final double value;
+  final double min;
+  final double max;
+  final int step;
+  final ValueChanged<double>? onChanged;
+
+  @override
+  Widget build(BuildContext context) {
+    final scheme = Theme.of(context).colorScheme;
+    final enabled = onChanged != null;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        ExcludeSemantics(
+          child: ListPageRow(icon: icon, title: title, value: label, iconColor: enabled ? null : scheme.onSurface.withValues(alpha: 0.3)),
+        ),
+        Padding(
+          padding: const EdgeInsets.fromLTRB(
+            ListPageRow.horizontal + ListPageRow.glyphSlot + ListPageRow.gap,
+            0,
+            ListPageRow.horizontal,
+            12,
+          ),
+          // One node: "大小, 56 dp".
+          child: MergeSemantics(
+            child: Semantics(
+              label: title,
+              child: Slider(
+                value: value.clamp(min, max).toDouble(),
+                min: min,
+                max: max,
+                divisions: ((max - min) ~/ step).clamp(1, 1000).toInt(),
+                padding: EdgeInsets.zero,
+                activeColor: enabled ? scheme.onSurfaceVariant : scheme.onSurface.withValues(alpha: 0.2),
+                inactiveColor: scheme.onSurface.withValues(alpha: 0.1),
+                semanticFormatterCallback: (v) => label,
+                onChanged: onChanged == null
+                    ? null
+                    : (v) {
+                        HapticFeedback.selectionClick();
+                        onChanged!(v);
+                      },
+              ),
+            ),
+          ),
+        ),
+      ],
+    );
+  }
+}
