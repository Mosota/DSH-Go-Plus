+        pad = dp(PAD_DP)
+        size = diameter + 2 * pad
+        margin = dp(EDGE_DP) - pad
+
+        val view = BallView(this)
+        view.setOnTouchListener(ballTouch)
+        view.setOnClickListener { togglePanel() }
+        val frame = FrameLayout(this).apply {
+            setPadding(pad, pad, pad, pad)
+            clipToPadding = false
+            clipChildren = false
+            addView(view, FrameLayout.LayoutParams(diameter, diameter))
+        }
+        ball = view
+        root = frame
+        frame.alpha = prefs.opacity
+        halfHidden = false
+        // The ball arrives with a short fade and a breath of scale: it is what stays when the
+        // picture window folds away, so it must not simply pop into place.
+        view.alpha = 0f
+        view.scaleX = APPEAR_SCALE
+        view.scaleY = APPEAR_SCALE
+
+        val p = WindowManager.LayoutParams(
+            size,
+            size,
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            // NO_LIMITS: the idle state really sits half past the edge; without it some ROMs
+            // clamp the window back on screen and the half circle never shows.
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+            PixelFormat.TRANSLUCENT,
+        ).apply {
+            gravity = Gravity.TOP or Gravity.START
+            title = "悬浮球"
+            if (Build.VERSION.SDK_INT >= 30) setFitInsetsTypes(0)
+        }
+        p.x = dockedX()
+        p.y = dockedY()
+        params = p
+        try {
+            windows.addView(frame, p)
+            // Started once the window is attached: on a detached view the animator would jump to
+            // its end values and the arrival would never be seen.
+            view.animate().alpha(1f).scaleX(1f).scaleY(1f)
+                .setDuration(APPEAR_MS).setInterpolator(OverlayMotion.emphasized)
+                .withEndAction {
+                    if (ball === view) {
+                        view.alpha = 1f
+                        view.scaleX = 1f
+                        view.scaleY = 1f
+                    }
+                }
+                .start()
+            showing = true
+        } catch (e: Exception) {
+            // The vendor's own floating-window switch can refuse after canDrawOverlays said yes.
+            Log.w(TAG, "vscreen ball window refused", e)
